# ---------------------------------------------------------------------------
# Environment variable reference — copy to .env and fill in real values.
# NEVER commit .env to source control.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_ENV=development          # development | production

# --- Server -----------------------------------------------------------------
APP__SERVER__HOST=0.0.0.0
APP__SERVER__PORT=8080

# --- Database ---------------------------------------------------------------
# Option A — Native PostgreSQL on port 5432 (use 127.0.0.1, not localhost,
#             to force TCP and avoid Linux peer-auth failures):
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/forgebike
#
# Option B — Docker postgres service (docker-compose maps container to 5435):
# DATABASE_URL=postgres://postgres:password@127.0.0.1:5435/forgebike
APP__DATABASE__MAX_CONNECTIONS=10

# --- Redis ------------------------------------------------------------------
APP__REDIS__URL=redis://127.0.0.1:6379

# --- Logging ----------------------------------------------------------------
APP__APP__LOG_LEVEL=info     # trace | debug | info | warn | error
RUST_LOG=info                # also accepted by the EnvFilter fallback

# ---------------------------------------------------------------------------
# Phase 1+ secrets — add these when implementing auth / integrations.
# ---------------------------------------------------------------------------

# JWT_SECRET=<generate with: openssl rand -hex 32>
#
# Phase 3 — review platform API keys
# APP__EXTERNAL_APIS__GOOGLE_PLACES_API_KEY=   # Google Cloud Console → Places API
# APP__EXTERNAL_APIS__YELP_API_KEY=            # Yelp Fusion → Manage App
# APP__EXTERNAL_APIS__TRIPADVISOR_API_KEY=     # TripAdvisor Content API
#
# Phase 4+ secrets
# OPENAI_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
