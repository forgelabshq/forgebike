# Rust build artefacts
/target

# Cargo lock is committed for applications (binary crates).
# Do not add Cargo.lock here.

# Local environment — contains secrets, never commit.
.env
.env.local

# Per-environment config overrides — may contain secrets.
config/development.toml
config/production.toml
config/staging.toml

# sqlx offline query cache — generated by `cargo sqlx prepare`.
# Commit this file if you want CI to run sqlx checks without a live DB.
# Leave it gitignored if you always run against a real DB in CI.
# .sqlx/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
.DS_Store
